# Set these in the deployment environment. This application does not auto-load .env files.
PORT=3000
USDT_ETB_RATE=182.2
# Generate a long random admin token; never expose it in client code.
ADMIN_TOKEN=
# Persistent private storage, outside public/. Back up and enforce a retention policy.
DATA_DIR=/workspace/Peer-to-Peer/.data
# Provisional list: confirm your own receiving support before launching.
ENABLED_NETWORKS=TRC20,ERC20,BEP20,SOL,TON,ARBITRUM,OPTIMISM,POLYGON,AVAXC,APTOS
# Optional Telegram notification delivery. Start your bot before using its chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Production durable storage (set BOTH; never expose service role key to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
